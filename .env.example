GEMINI_API_KEY=
GEMINI_MODEL=
MONGODB_URI=
MONGODB_DB=
AI_ACCESS_TOKEN=
ALLOWED_ORIGINS=
PORT=
HOST=
MAX_CONCURRENT_REQUESTS=
MONGODB_DNS_SERVERS=
# Day 11: user quota (defaults 30/day UTC and 5/minute)
USER_DAILY_REQUEST_LIMIT=30
USER_MINUTE_REQUEST_LIMIT=5
USER_AI_ATTEMPTS_PER_MINUTE=30

# Email recovery / verification (backend only; fill actual values in .env)
RESEND_API_KEY=
MAIL_FROM=
APP_PUBLIC_URL=http://127.0.0.1:5173

# Production: PORT is the public gateway port; API_PORT is private.
# Local npm run dev still uses PORT for the development API.
API_PORT=3001
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Set loopback only when Nginx is the private loopback upstream.
TRUST_PROXY=
# Conservative global admission budget per UTC day; not a monetary billing cap.
GLOBAL_DAILY_AI_LIMIT=500
# Optional isolated integration database. Never use the application URI here.
MONGODB_TEST_URI=
MONGODB_TEST_ALLOW_WRITE=

# Maximum generation budget per AI response; increasing can increase token cost.
AI_MAX_OUTPUT_TOKENS=8192
