{
  "name": "student-pdf-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev:backend\" \"npm run dev:frontend -- --host 127.0.0.1 --port 5173 --strictPort\"",
    "build": "tsc -b && tsc -p backend/tsconfig.json && vite build",
    "build:static": "node --env-file-if-exists=.env scripts/build-static.mjs",
    "check:pdf": "node scripts/check-pdf-fixtures.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:backend": "node --env-file-if-exists=.env --experimental-strip-types backend/scripts/check-connection.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "server": "npm run dev:backend",
    "server:production": "node --env-file-if-exists=.env --experimental-strip-types backend/src/index.ts",
    "predev:frontend": "node scripts/sync-pdfjs-assets.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node --env-file-if-exists=.env --experimental-strip-types backend/src/index.ts --development"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^1.63.0",
    "mongodb": "^7.8.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
